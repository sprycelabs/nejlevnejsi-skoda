{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nejlevnejsi-skoda.cz" }],
      "destination": "https://nejlevnejsi-skoda.cz/:path*",
      "permanent": true
    },
    { "source": "/fabia-dynamic-config", "destination": "/vozy/fabia-dynamic-config", "permanent": true },
    { "source": "/fabia-dynamic",        "destination": "/vozy/fabia-dynamic",        "permanent": true },
    { "source": "/:path+/",             "destination": "/:path+",                    "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/)(?!@)(?!__vite)(?!node_modules)(?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "functions": {
    "api/order.js": {
      "includeFiles": "public/logo.png|api/fonts/**"
    }
  }
}
