    width: auto !important;
    box-shadow: rgba(0, 0, 0, 0.5) 1px 3px 40px 0px !important;
    font-family: SKODANext, SkodaNext, "SKODA Next", SkodaNEXT, SkodaPro, Tahoma, Helvetica, sans-serif;
}

    #onetrust-banner-sdk :focus {
        outline: none;
    }

    #onetrust-banner-sdk #onetrust-close-btn-container {
        top: 24px;
    }

    #onetrust-banner-sdk.otCenterRounded {
        bottom: auto;
        max-height: 65%;
        scrollbar-width: thin; /*FF*/
        scrollbar-color: #161718 transparent; /*FF*/
        direction: ltr;
    }

:root[dir="rtl"] #onetrust-banner-sdk.otCenterRounded {
    direction: rtl;
}

#onetrust-banner-sdk #onetrust-policy {
    margin: 10px 25px 60px 25px;
    width: auto;
    color: #161718;
    padding: 25px 30px 0px 45px;
}

#onetrust-banner-sdk #onetrust-policy-title {
    font-weight: bold;
    padding-bottom: 25px;
    padding-top: 40px;
    font-size: 36px;
    line-height: 1.19;
}

#onetrust-banner-sdk #onetrust-policy-text,
#onetrust-banner-sdk .ot-b-addl-desc {
    font-size: 18px;
    font-weight: 100;
    line-height: 1.5;
}

#onetrust-consent-sdk #onetrust-policy-title,
#onetrust-consent-sdk #onetrust-policy-text {
    color: #161718;
    font-stretch: normal;
    font-style: normal;
    letter-spacing: normal;
    background-color: #fff;
}

#onetrust-group-container #onetrust-policy #onetrust-policy-text a {
    color: #31694b;
    background-color: #fff;
    text-decoration: underline;
    font-weight: 100;
}

    #onetrust-group-container #onetrust-policy #onetrust-policy-text a:hover {
        opacity: unset;
        color: #2d5540;
        background-color: #fff;
    }

#onetrust-consent-sdk #onetrust-banner-sdk .ot-cookie-policy-link:focus {
    outline-color: #0666ed;
    color: #2d5540 !important;
    outline-width: 2px;
    border-radius: 1px;
    outline-offset: 2px !important;
}

#onetrust-banner-sdk #onetrust-button-group-parent {
    position: sticky;
    bottom: 0;
    background: #fff;
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.05);
    padding: 15px 80px;
}

#onetrust-banner-sdk #onetrust-button-group button {
    border-radius: 50px;
    border: 2px solid #161718;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 12px;
    background-color: #fff;
    color: #161718;
    display: inline-block;
}

#onetrust-banner-sdk #onetrust-button-group-parent {
    display: block !important;
}

#onetrust-banner-sdk #onetrust-button-group {
    display: grid !important;
    grid-template-columns: auto auto;
    justify-content: center !important;
    align-items: center;
    gap: 15px 20px;
    width: 100% !important;
    float: none !important;
    text-align: center;
}

    #onetrust-banner-sdk #onetrust-button-group .banner-actions-container {
        display: contents;
    }

    #onetrust-banner-sdk #onetrust-button-group button,
    #onetrust-banner-sdk #onetrust-button-group #onetrust-pc-btn-handler.cookie-setting-link {
        float: none !important;
        margin: 0 !important;
        width: auto !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box;
    }

    #onetrust-banner-sdk #onetrust-button-group > button:nth-child(3):last-child,
    #onetrust-banner-sdk
    #onetrust-button-group:has(#onetrust-reject-all-handler)
    #onetrust-pc-btn-handler {
        grid-column: 1 / -1;
        justify-self: center;
    }

    /* 1 tlačítko: spanuje přes oba sloupce, vycentrované */
    #onetrust-banner-sdk #onetrust-button-group > button:only-child {
        grid-column: 1 / -1;
        justify-self: center;
    }

#onetrust-banner-sdk
.has-reject-all-button
#onetrust-pc-btn-handler.cookie-setting-link {
    text-align: center;
    max-width: 100%;
}

#onetrust-banner-sdk .has-reject-all-button #onetrust-pc-btn-handler {
    max-width: 100%;
}

#onetrust-banner-sdk #onetrust-accept-btn-handler,
#onetrust-banner-sdk #onetrust-reject-all-handler,
#onetrust-banner-sdk #onetrust-pc-btn-handler,
#onetrust-banner-sdk #onetrust-pc-btn-handler.cookie-setting-link,
#onetrust-banner-sdk #onetrust-pc-btn-handler.cookie-setting-link:last-child {
    height: auto;
    min-height: 45px;
    background-color: #fff;
    border: 1px solid #161718;
    color: #161718;
    text-decoration: none;
    padding: 0 30px;
}

    #onetrust-banner-sdk button#onetrust-accept-btn-handler:hover,
    #onetrust-banner-sdk #onetrust-pc-btn-handler.cookie-setting-link:hover,
    #onetrust-button-group #onetrust-reject-all-handler:hover,
    #onetrust-banner-sdk
    #onetrust-pc-btn-handler.cookie-setting-link:last-child:hover,
    #onetrust-consent-sdk #onetrust-pc-btn-handler:hover {
        border-radius: 22.5px;
        background-color: rgba(22, 23, 24, 0.06) !important;
        color: #161718;
        opacity: unset;
    }

#onetrust-banner-sdk .ot-close-icon {
    border-radius: 50px;
    border-width: 2px;
    border-style: solid;
    border-color: #161718;
}

    #onetrust-banner-sdk .ot-close-icon:hover {
        background-color: #f1f1f1;
        border-color: #161718 !important;
    }

#onetrust-consent-sdk #onetrust-banner-sdk .ot-close-icon:focus {
    outline-color: #0666ed !important;
    outline-width: 2px !important;
    background-color: #f1f1f1;
    outline-offset: 2px;
    border-color: #161718;
}

#onetrust-banner-sdk #onetrust-accept-btn-handler,
#onetrust-banner-sdk #onetrust-reject-all-handler,
#onetrust-banner-sdk #onetrust-pc-btn-handler {
    white-space: normal;
    word-break: break-word;
    overflow-wrap: break-word;
}

#onetrust-banner-sdk #onetrust-button-group button:focus,
#onetrust-banner-sdk #onetrust-button-group button:focus-visible {
    outline: 2px solid #0666ed;
    outline-offset: 2px !important;
    background-color: #f1f1f1 !important;
}

@media only screen and (max-width: 480px) {
    #onetrust-banner-sdk.otCenterRounded {
        width: 100% !important;
        height: 100%;
        min-width: 100%;
        min-height: 100%;
        max-height: -webkit-fill-available;
        max-height: -moz-fit-content; /*FF*/
        max-width: 100vw !important;
        overflow-x: hidden;
    }

    #onetrust-banner-sdk #onetrust-button-group-parent {
        max-width: 100%;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    #onetrust-banner-sdk #onetrust-policy-title {
        font-size: 30px;
        padding-bottom: 10px !important;
        width: auto;
    }

    #onetrust-banner-sdk #onetrust-policy {
        padding: 30px 25px 60px 25px;
        margin: 0px;
    }

    #onetrust-banner-sdk #onetrust-policy-text,
    #onetrust-banner-sdk .ot-b-addl-desc {
        width: auto;
        font-size: 16px;
    }

    #onetrust-banner-sdk #onetrust-button-group {
        grid-template-columns: minmax(0, 1fr) !important;
        max-width: 100%;
        box-sizing: border-box;
    }

        #onetrust-banner-sdk#onetrust-banner-sdk #onetrust-button-group button,
        #onetrust-banner-sdk#onetrust-banner-sdk #onetrust-button-group #onetrust-pc-btn-handler.cookie-setting-link,
        #onetrust-banner-sdk.ot-buttons-fw #onetrust-button-group button,
        #onetrust-banner-sdk.ot-buttons-fw #onetrust-button-group #onetrust-pc-btn-handler.cookie-setting-link,
        #onetrust-banner-sdk #onetrust-button-group button,
        #onetrust-banner-sdk #onetrust-button-group #onetrust-pc-btn-handler.cookie-setting-link {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            justify-self: stretch !important;
            grid-column: 1 / -1;
            white-space: normal !important;
            height: auto !important;
            min-height: 45px;
            box-sizing: border-box !important;
        }

    #onetrust-banner-sdk #onetrust-pc-btn-handler,
    #onetrust-banner-sdk #onetrust-pc-btn-handler.cookie-setting-link {
        width: 100%;
        margin-right: 0px;
    }

    #onetrust-banner-sdk #onetrust-pc-btn-handler {
        max-width: 100%;
    }

    #onetrust-banner-sdk
    .has-reject-all-button
    #onetrust-pc-btn-handler.cookie-setting-link {
        max-width: 100%;
    }

    #onetrust-banner-sdk #onetrust-reject-all-handler {
        margin-right: 0px;
    }

    #onetrust-banner-sdk #onetrust-button-group-parent {
        padding: 15px 30px;
    }
}

@media only screen and (min-width: 426px) and (max-width: 480px) {
    #onetrust-banner-sdk.otCenterRounded {
        top: 13%;
    }
}

#onetrust-consent-sdk #onetrust-banner-sdk a:focus {
    outline-color: #0666ed;
    color: #2d5540 !important;
    outline-width: 2px;
    border-radius: 1px;
    outline-offset: 2px !important;
