                background-color: #468254;
            }
                #onetrust-consent-sdk #onetrust-pc-sdk .ot-switch-nob {
                    background-color: #767676;
                }
            #onetrust-consent-sdk #onetrust-pc-sdk .ot-tgl input:focus + .ot-switch, .ot-switch .ot-switch-nob, .ot-switch .ot-switch-nob:before,
            #onetrust-pc-sdk .ot-checkbox input[type="checkbox"]:focus + label::before,
            #onetrust-pc-sdk .ot-chkbox input[type="checkbox"]:focus + label::before {
                outline-color: #000000;
                outline-width: 1px;
                outline-offset: 1px;
            }
            #onetrust-pc-sdk .ot-host-item > button:focus, #onetrust-pc-sdk .ot-ven-item > button:focus {
                border: 1px solid #000000;
            }
            #onetrust-consent-sdk #onetrust-pc-sdk *:focus,
            #onetrust-consent-sdk #onetrust-pc-sdk .ot-vlst-cntr > a:focus {
               outline: 1px solid #000000;
               outline-offset: 1px;
            }#onetrust-pc-sdk.ot-sdk-container {
    box-shadow: rgba(0, 0, 0, 0.5) 1px 3px 40px 0px !important;
    font-family: SKODANext, SkodaNext, "SKODA Next", SkodaNEXT, SkodaPro, Tahoma, Helvetica, sans-serif;
}

#onetrust-pc-sdk {
    max-width: 650px;
    max-height: 650px;
}

    #onetrust-pc-sdk #ot-pc-content {
        width: -webkit-fill-available;
        width: -moz-available; /*FF*/
        scrollbar-width: thin; /*FF*/
        scrollbar-color: #161718 transparent; /*FF*/
        font-size: 18px;
        padding: 0px 125px;
        margin: 0px;
        overflow-y: auto !important;
    }

    #onetrust-pc-sdk .ot-accordion-layout.ot-cat-item {
        border: none;
    }

    :root[dir="rtl"] #onetrust-pc-sdk .ot-vs-config .ot-acc-hdr,
    #onetrust-pc-sdk ul.ot-subgrps .ot-acc-hdr,
    #onetrust-pc-sdk .ot-subgrp-cntr ul.ot-subgrps .ot-acc-hdr,
    #onetrust-pc-sdk .ot-vs-list .ot-vnd-item .ot-acc-hdr,
    #onetrust-pc-sdk .ot-vnd-serv .ot-vnd-item .ot-acc-hdr,
    #onetrust-pc-sdk #ot-pc-lst .ot-vs-list .ot-vnd-item .ot-acc-hdr,
    #onetrust-pc-sdk .ot-accordion-layout.ot-checkbox-consent .ot-acc-hdr {
        direction: rtl;
    }

    #onetrust-pc-sdk.otPcCenter {
        direction: ltr;
        width: 650px;
        height: 650px !important;
        max-width: 650px;
        max-height: 650px;
    }

:root[dir="rtl"] #onetrust-pc-sdk.otPcCenter {
    direction: rtl;
}

#onetrust-pc-sdk
input[type="checkbox"]:focus + label.ot-switch > .ot-switch-nob {
    outline: 2px solid #0666ed !important;
    outline-offset: 2px !important;
}

#onetrust-pc-sdk .ot-pc-logo {
    visibility: hidden;
}

    #onetrust-pc-sdk .ot-pc-logo img {
        visibility: hidden !important;
    }

#onetrust-pc-sdk .ot-pc-header {
    visibility: hidden;
}

#onetrust-pc-sdk .ot-pc-footer {
    background: #fff;
    box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.05);
    border-top: unset;
    padding: 15px 30px !important;
    box-sizing: border-box;
    z-index: 10;
    --ot-footer-space: 150px !important;
}

#onetrust-pc-sdk #ot-pc-content {
    --ot-footer-space: 150px !important;
}

:root[dir="rtl"] #onetrust-pc-sdk .ot-pc-footer {
    direction: rtl;
}

#onetrust-pc-sdk #content.main-content {
    margin: 60px 30px 30px 60px;
}

#onetrust-pc-sdk #ot-pc-title,
#onetrust-pc-sdk #ot-category-title {
    background-color: #fff;
    padding-bottom: 10px !important;
    font-size: 36px;
    line-height: 1.2;
    word-wrap: break-word;
    color: #161718 !important;
}

#onetrust-pc-sdk #ot-category-title {
    margin-top: 40px;
}

#onetrust-pc-sdk #ot-pc-desc,
#onetrust-pc-sdk .ot-cat-item p {
    font-weight: 100;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: normal;
    background-color: #fff;
    font-size: 18px;
}

#onetrust-pc-sdk .ot-cat-header,
#onetrust-pc-sdk #ot-lst-title,
#onetrust-pc-sdk .ot-ven-hdr .ot-ven-name,
#onetrust-pc-sdk .ot-always-active {
    font-size: 18px;
    color: #161718 !important;
}

#onetrust-pc-sdk .ot-cat-header {
    font-weight: 700;
}

#onetrust-pc-sdk .ot-cat-grp .ot-always-active {
    font-weight: 300;
}

#onetrust-pc-sdk #ot-pc-desc a {
    color: #31694b !important;
    margin-top: 30px;
    margin-bottom: 30px;
    background-color: #fff;
    text-decoration: underline;
    font-weight: unset;
    line-height: 1;
    letter-spacing: 1px;
    margin-left: 0px;
}

    #onetrust-pc-sdk #ot-pc-desc a:hover {
        background-color: #fff;
        color: #2d5540 !important;
    }

    #onetrust-pc-sdk #ot-pc-desc a:focus {
        outline-color: #0666ed;
        color: #2d5540 !important;
        outline-width: 2px;
        border-radius: 4px;
        outline-offset: 2px !important;
    }

#onetrust-pc-sdk .ot-pc-logo,
#onetrust-pc-sdk .ot-pc-logo img {
    visibility: hidden;
}

#onetrust-pc-sdk .ot-switch,
#onetrust-pc-sdk .category-item .ot-switch {
    width: 45px;
}

#onetrust-pc-sdk .ot-switch-nob {
    background-color: #7c7d7e;
    border: 1px solid #7c7d7e;
    border-radius: 25px;
    width: 53px;
    height: 25px;
}

    #onetrust-pc-sdk .ot-switch-nob:before {
        width: 17px;
        height: 17.5px;
        left: 1px;
        right: 30px;
        background: #ffffff;
        border: 2px solid #ffffff;
        border-radius: 200px;
        margin: 0px;
        bottom: 2px;
    }

#onetrust-pc-sdk .ot-tgl input:checked + .ot-switch .ot-switch-nob {
    background-color: #31694B;
    border: 1px solid #31694B;
}

    #onetrust-pc-sdk .ot-tgl input:checked + .ot-switch .ot-switch-nob:before {
        right: -19px;
        background-color: #fff;
        border-color: #fff;
        width: 17px;
        height: 17.5px;
        left: 10px;
    }

#onetrust-pc-sdk .ot-pc-footer-logo {
    display: none !important;
}

#onetrust-consent-sdk #onetrust-pc-sdk .ot-tgl input:focus + .ot-switch,
.ot-switch .ot-switch-nob,
.ot-switch .ot-switch-nob:before,
#onetrust-pc-sdk .ot-checkbox input[type="checkbox"]:focus + label::before,
#onetrust-pc-sdk .ot-chkbox input[type="checkbox"]:focus + label::before {
    outline: none;
}

#onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon {
    border-radius: 50px;
    border-width: 2px;
    border-style: solid;
    border-color: #161718;
    right: 10px;
}

    #onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon:hover {
        background-color: #f1f1f1;
        border-color: #161718 !important;
    }

    #onetrust-pc-sdk #close-pc-btn-handler.ot-close-icon:focus {
        outline-color: #0666ed !important;
        outline-width: 2px !important;
        background-color: #f1f1f1 !important;
        outline-offset: 2px;
        border-color: #161718;
    }

#onetrust-consent-sdk
#onetrust-pc-sdk
button:not(#clear-filters-handler):not(.ot-close-icon):not( #filter-btn-handler ):not(.ot-remove-objection-handler):not(.ot-obj-leg-btn-handler):not( [aria-expanded] ):not(.ot-link-btn),
#onetrust-pc-sdk #accept-recommended-btn-handler {
    height: auto;
    min-height: 45px;
    background-color: #fff;
    border: 2px solid #161718;
    color: #161718;
    text-decoration: none;
    padding: 0 30px;
    border-radius: 50px;
    font-weight: bold;
    font-size: 12px;
}

    #onetrust-consent-sdk
    #onetrust-pc-sdk
    button:not(#clear-filters-handler):not(.ot-close-icon):not( #filter-btn-handler ):not(.ot-remove-objection-handler):not(.ot-obj-leg-btn-handler):not( [aria-expanded] ):not(.ot-link-btn):focus,
    #onetrust-consent-sdk
    #onetrust-pc-sdk
    button:not(#clear-filters-handler):not(.ot-close-icon):not( #filter-btn-handler ):not(.ot-remove-objection-handler):not(.ot-obj-leg-btn-handler):not( [aria-expanded] ):not(.ot-link-btn):focus-visible {
        outline: 2px solid #0666ed !important;
        outline-offset: 2px !important;
        background-color: #f1f1f1 !important;
    }

    #onetrust-pc-sdk #accept-recommended-btn-handler:hover,
    #onetrust-pc-sdk .save-preference-btn-handler:hover {
        background-color: #f1f1f1 !important;
        color: #161718 !important;
        border: 2px solid #161718 !important;
        opacity: unset !important;
    }

#onetrust-pc-sdk .ot-btn-container {
    display: grid !important;
    grid-template-columns: auto auto;
    justify-content: center !important;
    align-items: center;
    gap: 15px 20px;
    width: 100%;
    text-align: center !important;
}

    #onetrust-pc-sdk .ot-btn-container > button {
        margin: 0 !important;
        float: none !important;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: break-word;
        width: auto !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box;
    }

        /* 3 tlačítka: poslední skočí na svůj řádek přes oba sloupce */
        #onetrust-pc-sdk .ot-btn-container > button:nth-child(3):last-child {
            grid-column: 1 / -1;
            justify-self: center;
        }

        /* 1 tlačítko: spanuje přes oba sloupce, vycentrované */
        #onetrust-pc-sdk .ot-btn-container > button:only-child {
            grid-column: 1 / -1;
            justify-self: center;
        }

#onetrust-pc-sdk .ot-pc-refuse-all-handler,
#onetrust-pc-sdk #accept-recommended-btn-handler,
#onetrust-consent-sdk #onetrust-pc-sdk .save-preference-btn-handler {
    background-color: #fff !important;
    border: 2px solid #161718 !important;
}

#onetrust-consent-sdk #onetrust-pc-sdk .ot-pc-refuse-all-handler:hover {
    background-color: #f1f1f1 !important;
    border: 2px solid #161718 !important;
    color: #161718;
    opacity: unset;
}

#onetrust-consent-sdk #onetrust-pc-sdk .ot-pc-refuse-all-handler:focus {
    background-color: #f1f1f1 !important;
    border: 2px solid #161718 !important;
    color: #161718;
    outline: 2px solid #0666ed !important;
    outline-offset: 2px !important;
}

#onetrust-pc-sdk .ot-sdk-column button#accept-recommended-btn-handler:hover,
#onetrust-consent-sdk #onetrust-pc-sdk .save-preference-btn-handler:hover {
    background-color: #f1f1f1 !important;
    color: #161718 !important;
    border: 2px solid #161718 !important;
    opacity: unset !important;
}

#onetrust-pc-sdk #accept-recommended-btn-handler {
    display: flex !important;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-left: auto;
    margin-right: auto !important;
}

:root[dir="rtl"] #onetrust-pc-sdk .ot-tgl input:checked + .ot-switch .ot-switch-nob:before {
    left: 30px;
    right: -18px;
}

:root[dir="rtl"] #onetrust-pc-sdk .ot-switch-nob {
    transform: rotateY(180deg);
}

@media only screen and (max-width: 600px) {
    #onetrust-pc-sdk.otPcCenter {
        width: auto;
        height: 100% !important;
        max-width: 100%;
        max-height: 100%;
    }
}

@media only screen and (max-width: 480px) {
    #onetrust-pc-sdk .ot-pc-footer,
    #onetrust-pc-sdk #ot-pc-content {
        --ot-footer-space: 210px !important;
    }

    #onetrust-pc-sdk #ot-pc-content {
        max-width: 100% !important;
        padding: 0px 20px 0px 30px;
        overflow-y: auto !important;
    }

    #onetrust-pc-sdk #ot-pc-title,
    #onetrust-pc-sdk #ot-category-title {
        font-size: 30px;
    }

    #onetrust-pc-sdk #ot-pc-desc,
    #onetrust-pc-sdk .ot-cat-item p {
        font-size: 16px;
    }

    #onetrust-pc-sdk .ot-pc-footer {
        padding: 15px 30px !important;
    }

    #onetrust-pc-sdk .ot-btn-container {
        grid-template-columns: minmax(0, 1fr) !important;
        margin: 0 !important;
        max-width: 100%;
        box-sizing: border-box;
    }

        #onetrust-pc-sdk#onetrust-pc-sdk .ot-btn-container button,
        #onetrust-pc-sdk .ot-btn-container button,
        #onetrust-pc-sdk .ot-btn-container #accept-recommended-btn-handler {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            margin: 0 !important;
            justify-self: stretch !important;
            grid-column: 1 / -1;
            white-space: normal !important;
            height: auto !important;
            min-height: 45px;
            box-sizing: border-box !important;
        }

    #onetrust-pc-sdk.otPcCenter {
        width: 100% !important;
        max-width: 100vw !important;
        overflow-x: hidden;
    }

    #onetrust-pc-sdk .ot-pc-footer {
        max-width: 100%;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    #onetrust-pc-sdk.ot-ftr-stacked .ot-pc-refuse-all-handler,
    #onetrust-pc-sdk .save-preference-btn-handler {
        margin: 5px;
    }
}
