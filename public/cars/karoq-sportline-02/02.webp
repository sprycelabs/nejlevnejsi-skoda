id&quot;:&quot;c79ce385-5420-4e45-8581-31ae4c681c85_5531267a-5761-49e5-a537-ed95c395e4a7&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Zaměstnanecký program&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/pro-firmy/zamestnanecky-program&quot;}},{&quot;id&quot;:&quot;c79ce385-5420-4e45-8581-31ae4c681c85_00000000-0000-0000-0000-000000000000&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Škoda Octavia pro Vaši firmu&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/promotions/promotion-detail/skoda-octavia-fleet&quot;}},{&quot;id&quot;:&quot;c79ce385-5420-4e45-8581-31ae4c681c85_00000001-0000-0000-0000-000000000000&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Škoda Elroq pro Vaši firmu&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/promotions/promotion-detail/skoda-elroq-fleet&quot;}},{&quot;id&quot;:&quot;c79ce385-5420-4e45-8581-31ae4c681c85_00000002-0000-0000-0000-000000000000&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Škoda Enyaq pro Vaši firmu&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/promotions/promotion-detail/skoda-enyaq-fleet&quot;}}]},{&quot;id&quot;:&quot;00000000-0000-0000-0000-000000000000&quot;,&quot;text&quot;:&quot;Škoda Auto&quot;,&quot;link&quot;:null,&quot;children&quot;:[{&quot;id&quot;:&quot;additionalLink_0&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:true,&quot;label&quot;:&quot;Přihlášení/Registrace&quot;,&quot;url&quot;:&quot;https://skodaid.vwgroup.io/&quot;}},{&quot;id&quot;:&quot;additionalLink_1&quot;,&quot;link&quot;:{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Štítky pneumatik&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/o-spolecnosti/stitky-pneumatik&quot;}}]}],&quot;legalLinks&quot;:[{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Prohlášení o obsahu&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/sluzby/copyright&quot;},{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Ochrana osobních údajů&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/sluzby/ochrana-osobnich-udaju&quot;},{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Imprint&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/sluzby/imprint&quot;},{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Kybernetická bezpečnost&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/sluzby/kyberneticka-bezpecnost&quot;},{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Přístupnost&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.com/other/accessibility-information&quot;},{&quot;openInNewWindow&quot;:false,&quot;label&quot;:&quot;Nařízení o datech&quot;,&quot;url&quot;:&quot;https://www.skoda-auto.cz/sluzby/narizeni-o-datech&quot;}],&quot;languages&quot;:[],&quot;disclaimers&quot;:[{&quot;index&quot;:null,&quot;name&quot;:&quot;Právní upozornění&quot;,&quot;body&quot;:&quot;&lt;p&gt;&lt;strong&gt;Ceny vozů&lt;br&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Uváděné ceny jsou pouze orientační, doporučené výrobcem Škoda Auto, včetně DPH a&amp;nbsp;nejsou nabídkou ve&amp;nbsp;smyslu ust. §&amp;nbsp;1732 zákona č. 89/2012 Sb., občanský zákoník, ve&amp;nbsp;znění pozdějších předpisů. Aktuální cenu a&amp;nbsp;specifikaci vybraného modelu Vám na&amp;nbsp;požádání sdělí Váš autorizovaný prodejce vozů Škoda.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Technická data&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Uvedené technické hodnoty jsou přibližné a mají pouze informativní charakter.&lt;/p&gt;&lt;p&gt;Hodnoty spotřeby paliva a emisí CO&lt;sub&gt;2&lt;/sub&gt; byly stanoveny dle standardu WLTP. Jsou určeny pro porovnání hodnot CO&lt;sub&gt;2&lt;/sub&gt; a&amp;nbsp;spotřeby paliva mezi různými typy vozidel, mající informativní charakter platný k okamžiku konfigurace vozidla. Dodatečná výbava vozu a&amp;nbsp;příslušenství (např. vestavěné díly, jiné pneumatiky atd.) mohou měnit relevantní parametry vozidla jako hmotnost, valivý odpor a aerodynamiku a ve spojitosti s povětrnostními a&amp;nbsp;dopravními podmínkami a&amp;nbsp;individuálním stylem jízdy mohou ovlivnit spotřebu paliva, spotřebu elektrické energie, dojezd a&amp;nbsp;emise CO&lt;sub&gt;2&lt;/sub&gt; jakož i výkonnostní ukazatele vozidla.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Technická data – elektrické a hybridní vozy&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Dostupnost jízdního výkonu: Maximální jízdní výkon, který je k&amp;nbsp;dispozici při nejvyšším možném stavu nabití a&amp;nbsp;optimálním rozsahu provozních teplot vysokonapěťového akumulátoru. Výkon dostupný v&amp;nbsp;individuální jízdní situaci závisí na proměnlivých faktorech, jako je zejména stav nabití, venkovní teplota nebo stáří vysokonapěťového akumulátoru. Doba dostupnosti maximálního jízdního výkonu je omezena a&amp;nbsp;podle typu vysokonapěťového akumulátoru činí nejvýše 18&amp;nbsp;sekund (akumulátor o&amp;nbsp;kapacitě 82/84&amp;nbsp;kWh), případně nejvýše 30&amp;nbsp;sekund (akumulátor o&amp;nbsp;kapacitě 55/63&amp;nbsp;kWh).&lt;/p&gt;&lt;p&gt;Dojezd: Celkový dojezd dle standardu WLTP ve variantě výbavy, která je nejpříznivější pro dojezd tohoto modelu. Skutečné hodnoty dojezdu WLTP se mohou lišit v závislosti na výbavě. V praxi se skutečný dojezd liší v závislosti na stylu jízdy, rychlosti, použití komfortních/pomocných spotřebičů, venkovní teplotě, počtu cestujících/užitečném zatížení a&amp;nbsp;topografii.&lt;/p&gt;&lt;p&gt;Kapacita baterie: Obsah energie vysokonapěťového akumulátoru bez ohledu na vozidlo. Určuje se s konstantním profilem zatížení za definovaných okrajových podmínek a bere v&amp;nbsp;úvahu celý rozsah energetického obsahu vysokonapěťového akumulátoru, který lze ve vozidle využít až do zastavení vozidla. Skutečná vybíjecí energie se od toho může lišit, protože závisí na konkrétním jízdním profilu a teplotě akumulátoru. Homologovaná specifikace dojezdu podle standardu WLTP odpovídá využitelné vybíjecí energii pro nové vozidlo. Pro zachování nejlepší využitelné kapacity vysokonapěťového akumulátoru se při každodenním používání vozidla doporučuje nastavit cílovou úroveň nabití na 80&amp;nbsp;% (na&amp;nbsp;100&amp;nbsp;% doporučujeme vysokonapěťový akumulátor nabíjet například pouze před delší cestou). Snížení kapacity vysokonapěťového akumulátoru v průběhu času je přirozeným projevem techniky a není vadou.&lt;/p&gt;&lt;p&gt;Nabíjecí výkon: Maximální možný nabíjecí výkon. Různé nabíjecí stanice se mohou lišit svým chováním při nabíjení při stejném výkonu kW. Kromě kW výkonu nabíjecí stanice má na množství protékající energie vliv také maximální nabíjecí proud. Maximální možný nabíjecí výkon ovlivňuje mnoho faktorů, mj. okolní teplota, teplota akumulátoru, stav nabití akumulátoru, stáří akumulátoru, stav nabíjecí stanice a nabíjecí infrastruktury, zatíženost nabíjecí infrastruktury a zatíženost nabíjecí stanice (pokud se nabíjí současně další vůz na stejné stanici). Uvedený maximální nabíjecí výkon se určuje za podmínek standardu WLTP při teplotě cca. 23 °C a stavu nabití pět procent nebo více. Pokud se tyto proměnné změní, může se nabíjecí výkon také lišit od standardní specifikace. Více informací o elektrických a&amp;nbsp;hybridních modelech naleznete na našich webových stránkách &lt;a title=\&quot;\&quot; href=\&quot;https://www.skoda-auto.cz/emobilita/skoda-emobilita\&quot; target=\&quot;_self\&quot; data-mce-href=\&quot;https://www.skoda-auto.cz/emobilita/skoda-emobilita\&quot;&gt;skoda-auto.cz/emobilita&lt;/a&gt; a&amp;nbsp;&lt;a title=\&quot;\&quot; href=\&quot;https://elektromobilita.skoda-auto.cz/\&quot; target=\&quot;_blank\&quot; data-mce-href=\&quot;https://elektromobilita.skoda-auto.cz/\&quot;&gt;elektromobilita.skoda-auto.cz&lt;/a&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Škoda Originální příslušenství&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Uvedená cena Škoda Originálního příslušenství je pouze orientační a&amp;nbsp;není nabídkou ve&amp;nbsp;smyslu ust. §&amp;nbsp;1732 zákona č. 89/2012 Sb., občanský zákoník, ve&amp;nbsp;znění pozdějších předpisů. Aktuální cenu Škoda Originálního příslušenství Vám na&amp;nbsp;požádání sdělí Váš autorizovaný prodejce vozů Škoda. Uvedené ceny Škoda Originálního příslušenství nezahrnují případné náklady na&amp;nbsp;jejich montáž. Originální příslušenství je určeno k&amp;nbsp;instalaci až po&amp;nbsp;úvodní registraci vozidla a&amp;nbsp;ovlivňují emise CO&lt;sub&gt;2&lt;/sub&gt; vozidla. Změna emisí CO&lt;sub&gt;2&lt;/sub&gt; však není zohledněna v&amp;nbsp;prohlášení o&amp;nbsp;shodě vystavované Škoda Auto a.s. Montáž Škoda Originálního příslušenství a&amp;nbsp;mimořádná výbava vozidla mohou rovněž ovlivnit i&amp;nbsp;jiné relevantní parametry vozidla jako je hmotnost, valivý odpor, aerodynamika, jakož i&amp;nbsp;spotřeba pohonných hmot či výkonnostní ukazatele vozidla. Na&amp;nbsp;základě omezení dle zvolené motorizace či výbavy nemusí být montáž požadovaného příslušenství u&amp;nbsp;vybraného vozidla možná. Pro více informací kontaktujte svého autorizovaného prodejce vozů Škoda.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Uvedené údaje, použité fotografie&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Společnost Škoda Auto a.s. si vyhrazuje právo změny ceny, barvy a&amp;nbsp;technických dat modelů zde zobrazených a&amp;nbsp;popsaných. Použité obrázky jsou ilustrační a&amp;nbsp;mají pouze informativní charakter. Autoři serveru si vyhrazují právo chyb zápisu a&amp;nbsp;omylu. Vzhled barev a&amp;nbsp;vyvážení bílé závisí na&amp;nbsp;individuálním nastavení monitoru.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Internet, software&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Společnost Škoda Auto a.s. ani její zástupci nenesou žádnou odpovědnost za&amp;nbsp;jakékoli škody způsobené použitím této prezentace, zde publikovaných informací či softwaru zde nabízeného k&amp;nbsp;instalaci. Všechny informace, služby a&amp;nbsp;digitální obsah jsou nabízeny bez záruky nepřerušeného užívaní.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Ochrana osobních údajů&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Společnost Škoda Auto a.s. zaručuje všem uživatelům svých internetových prezentací ochranu osobních údajů. Škoda Auto a.s. neshromažďuje žádné osobní údaje, které uživatelé dobrovolně neposkytnou.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Copyright&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Obsah stránek skoda-auto.cz je chráněn autorským zákonem. Stahování materiálů a&amp;nbsp;dalšího obsahu je možné pouze v&amp;nbsp;případě, je-li to výslovně uvedeno. Kopírování a&amp;nbsp;šíření obsahu v&amp;nbsp;jakékoli podobě není bez písemného souhlasu autorů dovoleno. Monte-Carlo je registrovanou ochrannou známkou společnosti Marques De l’Etat De Monaco.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Škoda Connect – Digitální služby&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Pro využívání Škoda Connect (dále jen „Služby“) je nutné uzavřít online samostatnou smlouvu se&amp;nbsp;společností Škoda Auto a.s. Pro využívání Služeb po&amp;nbsp;celé smluvní období má zákazník po&amp;nbsp;předání vozidla 90denní lhůtu na&amp;nbsp;jejich zaregistrování. Služba Tísňové volání je aktivována již od&amp;nbsp;dodání vozidla bez nutnosti registrace.&lt;/p&gt;&lt;p&gt;Dostupnost poskytovaných Služeb může být v&amp;nbsp;každé zemi různá v&amp;nbsp;závislosti na&amp;nbsp;typu vozidla, roku výroby a&amp;nbsp;výbavovém stupni daného vozidla. Některé Služby mohou být dostupné později po&amp;nbsp;předání vozidla. Služby jsou poskytovány pouze na&amp;nbsp;základě veřejně dostupných telekomunikačních technologií. Z&amp;nbsp;důvodu neustálého vývoje technologií, zejména mobilní sítě, nemůže Škoda Auto a.s. garantovat konzistentní dostupnost těchto Služeb po&amp;nbsp;celou dobu jejich trvání. Možné vývojové změny mohou způsobit trvalou nedostupnost poskytovaných Služeb.&lt;/p&gt;&lt;p&gt;Pro používání Služeb je nutné datové spojení mezi Vaším zařízením (chytrý telefon, tablet, PC atd.) a&amp;nbsp;datovým serverem. Toto datové spojení není zahrnuto v&amp;nbsp;rámci Služeb. Bližší informace o&amp;nbsp;Službách naleznete na &lt;a title=\&quot;\&quot; href=\&quot;https://www.skoda-auto.cz/konektivita/skoda-connect\&quot; target=\&quot;_self\&quot; data-mce-href=\&quot;https://www.skoda-auto.cz/konektivita/skoda-connect\&quot;&gt;www.skoda-auto.cz/technologie/skoda-connect&lt;/a&gt;&amp;nbsp;nebo u&amp;nbsp;Vašeho autorizovaného partnera Škoda.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;a title=\&quot;\&quot; href=\&quot;https://www.skoda-auto.cz/_doc/843e7ba1-cca3-4d5b-8f5a-9c6af4ec7f85\&quot; target=\&quot;_blank\&quot; data-mce-href=\&quot;https://www.skoda-auto.cz/_doc/843e7ba1-cca3-4d5b-8f5a-9c6af4ec7f85\&quot;&gt;Third Party Licenses&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;&quot;,&quot;type&quot;:0},{&quot;name&quot;:&quot;StockAndUsedCarsLegalDisclaimer&quot;,&quot;body&quot;:&quot;&lt;div class=&#39;disclaimer-tool&#39; id=&#39;disclaimer-LegalDisclaimer&#39;&gt;Právní upozornění&lt;/div&gt;&quot;},{&quot;name&quot;:&quot;StockAndUsedCarsLegalDisclaimerNewCarsOnly&quot;,&quot;body&quot;:&quot;&lt;div class=&#39;disclaimer-tool&#39; id=&#39;disclaimer-LegalDisclaimerNewCarsOnly&#39;&gt;Právní upozornění pouze pro nové vozy&lt;/div&gt;&quot;}],&quot;disclaimersExtended&quot;:true,&quot;disclaimersIsTop&quot;:false,&quot;footerBanner&quot;:null,&quot;cookies&quot;:{&quot;cookiesSettingsPageUri&quot;:&quot;https://www.skoda-auto.cz/system/cookie-settings&quot;},&quot;resources&quot;:{&quot;M025.Cookies&quot;:&quot;Informace o cookies&quot;,&quot;M025.ConfigureCookies&quot;:&quot;Nastavení cookies&quot;,&quot;M025.Copyright&quot;:&quot;© Škoda Auto a.s. 2026&quot;,&quot;M025.Contacts_Helpline&quot;:&quot;Infolinka&quot;,&quot;M025.More_About_Skoda&quot;:&quot;Více o Škoda&quot;,&quot;M025.Contacts_WhatsApp&quot;:&quot;Messenger&quot;,&quot;M025.Contacts_Email&quot;:&quot;E-mail&quot;,&quot;M025.Disclaimers_Section_Title&quot;:&quot;Právní upozornění&quot;,&quot;M025.Contacts_Telegram&quot;:&quot;Telegram&quot;,&quot;M025.See_Also&quot;:&quot;Navštivte&quot;,&quot;M025.Contacts_Form&quot;:&quot;Kontaktní formulář&quot;,&quot;M025.Less_About_Skoda&quot;: